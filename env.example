# ============================================================
# arr-stack-gluetun — environment variables
# 1. Copy this file: cp .env.example .env
# 2. Fill in your values
# 3. NEVER commit .env to git — it contains your VPN keys
# ============================================================


# ----------------------------------------------------------
# OPTIONAL SERVICES
# Comma-separated list of profiles to enable.
# Leave blank for movies + shows only.
#
#   music      → adds Lidarr (music collection manager)
#   audiobooks → adds Bookshelf (audiobook automation)
#   subtitles  → adds Subgen (GPU subtitles, NVIDIA required)
#
# Examples:
#   COMPOSE_PROFILES=                           # movies + shows only
#   COMPOSE_PROFILES=music                      # + music
#   COMPOSE_PROFILES=music,audiobooks           # + music + audiobooks
#   COMPOSE_PROFILES=music,audiobooks,subtitles # everything
# ----------------------------------------------------------
COMPOSE_PROFILES=


# ----------------------------------------------------------
# VPN — WireGuard credentials
# Get these from your VPN provider's WireGuard config generator.
# See docs/vpn-providers.md for ProtonVPN, Mullvad, and others.
# Treat WIREGUARD_PRIVATE_KEY like a password — never share it.
# ----------------------------------------------------------
WIREGUARD_PRIVATE_KEY=CHANGE_ME_BASE64_PRIVATE_KEY
WIREGUARD_PUBLIC_KEY=CHANGE_ME_BASE64_PUBLIC_KEY

# The tunnel IP assigned to you by your VPN provider (from the [Interface] section)
WIREGUARD_ADDRESSES=10.x.x.x/32

# VPN server to connect to (from the [Peer] Endpoint line — IP only, not the port)
WIREGUARD_ENDPOINT_IP=CHANGE_ME_VPN_SERVER_IP
WIREGUARD_ENDPOINT_PORT=51820


# ----------------------------------------------------------
# NETWORK
# Your home network subnet — lets arr containers talk to your
# NAS, download clients, and other local devices without going
# through the VPN. Find yours with: ip route | grep -v default
#
# Common examples:
#   192.168.1.0/24
#   192.168.0.0/24
#   10.0.0.0/24
# ----------------------------------------------------------
LAN_SUBNET=192.168.1.0/24


# ----------------------------------------------------------
# PATHS
# Where things live on your server.
# ----------------------------------------------------------

# Where container config/settings are stored
APPDATA_PATH=/opt/appdata

# Root of your media library
# Radarr/Sonarr/Lidarr see this as /data internally
MEDIA_PATH=/mnt/media

# Where completed downloads land (main/slow disk)
DOWNLOADS_PATH=/mnt/downloads

# Fast-disk staging area for in-progress downloads
# On Unraid: /mnt/cache/downloads
# No separate fast disk? Set this the same as DOWNLOADS_PATH
CACHE_DOWNLOADS_PATH=/mnt/downloads


# ----------------------------------------------------------
# USER / GROUP IDs
# Controls which user owns files created by containers.
# Find your values with: id $(whoami)
#
# Unraid default (nobody): PUID=99, PGID=100
# Most Linux systems:      PUID=1000, PGID=1000
# ----------------------------------------------------------
PUID=99
PGID=100


# ----------------------------------------------------------
# TIMEZONE
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# ----------------------------------------------------------
TZ=America/Chicago
